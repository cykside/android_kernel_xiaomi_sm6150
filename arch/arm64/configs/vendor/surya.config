# Experimental POCO X3 NFC bring-up fragment; merge over gki_defconfig.
CONFIG_LOCALVERSION="-surya"
# KFENCE's toggle_allocation_gate() enables a static key from a workqueue,
# which serialises CPUs through kick_all_cpus_sync().  With one CPU wedged in
# the downstream PSCI idle path that worker never returns and RCU stalls on
# every grace period, so init is never reached (2026-11-27 20:46 capture,
# build 108d1f6c6: kworker/u16:1 stuck in smp_call_function_many_cond for
# 180s).  Sampling has no value while the storage path is being brought up.
# CONFIG_KFENCE is not set
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_SERIAL_EARLYCON_RAMOOPS=y
# Match Violet: do not replace a warm panic restart with download mode or a watchdog bite.
# CONFIG_POWER_RESET_QCOM_DOWNLOAD_MODE is not set
# CONFIG_QCOM_FORCE_WDOG_BITE_ON_PANIC is not set
CONFIG_ARCH_QCOM=y
CONFIG_ARCH_SA6155=y
# The inherited apps_smmu provider must be available without a vendor .ko.
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_QCOM=y
CONFIG_COMMON_CLK_QCOM=y
# The UFS host vdd-hba supply is a qcom,gdsc regulator.
CONFIG_QCOM_GDSC_REGULATOR=y
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_RPMH=y
CONFIG_INTERCONNECT_QCOM_SM6150=y
CONFIG_PINCTRL_MSM=y
CONFIG_PINCTRL_SM6150=y
CONFIG_PINCTRL_SDMMAGPIE=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_RPMH=y
# The GCC and UFS reference clocks consume the RPMh CXO provider.
CONFIG_QCOM_CLK_RPMH=y
# Providers referenced by the inherited SM6150 device tree.
CONFIG_REGULATOR_RPMH=y
# Preserve DT-declared boot votes until the real consumers bind.
CONFIG_REGULATOR_PROXY_CONSUMER=y
CONFIG_NVMEM_QCOM_QFPROM=y
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_QCOM_SMEM=y
CONFIG_SM_GCC_6150=y

# Build UFS support without probing the unvalidated board nodes.
#
# The symbol that binds our PHY is named after another board, and that label is
# what previously sent this tree down the wrong path.  What actually decides it
# is the stock DT: arch/arm64/boot/dts/qcom/sdmmagpie.dtsi:68 of the 4.14 source
# (the kernel that boots this board from UFS today) sets
#
#	&ufsphy_mem { compatible = "qcom,ufs-phy-qmp-v3"; };
#
# and in this tree the only file whose of_match_table carries that string is
# drivers/phy/qualcomm/phy-qcom-ufs-qmp-v3.c -- built by PHY_QCOM_UFS_V3_SM4350,
# despite the name (SM4350 is 11nm with the same QMP v3 PHY, so the two boards
# share the file; PHY_QCOM_UFS_V3 builds the *SDM660* driver, which matches
# "qcom,ufs-phy-qmp-v3-660" instead, and PHY_QCOM_UFS_V4 matches
# "qcom,ufs-phy-qmp-v4").  The sequences are not equivalent: of the 88
# {register, value} pairs in stock's phy-qcom-ufs-qmp-v3.h calibration tables,
# this tree's phy-qcom-ufs-qmp-v3.h reproduces 88, phy-qcom-ufs-qmp-v4.h 33 and
# phy-qcom-ufs-qmp-v3-660.h 27.  So with V4 bound, two thirds of the QSERDES/PA
# trim registers are programmed for another PHY revision, which is a link that
# never trains -- and a link that never trains is exactly the silence this board
# has been producing.  V4 stays on because nothing else here should regress; the
# compatible in surya-sm6150.dts picks the driver.
#
# Both are asserted by .github/workflows/surya-dtb.yml, which now checks the
# node's compatible string against the of_match tables of the *built* drivers
# rather than against a Kconfig help text.
CONFIG_PHY_QCOM_UFS=y
CONFIG_PHY_QCOM_UFS_V4=y
CONFIG_PHY_QCOM_UFS_V3_SM4350=y
CONFIG_SCSI_UFS_QCOM=y

# Driver support for later USB bring-up; board controllers stay disabled.
CONFIG_USB_DWC3_MSM=y
CONFIG_MSM_QUSB_PHY=y

# PM6150 PD PHY and policy support for the staged Type-C path.
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
# The PMIC arbiter periph_irq is routed through the PDC irq domain.
CONFIG_QCOM_PDC=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_EXTCON=y
CONFIG_USB_PD_POLICY=y
CONFIG_QPNP_USB_PDPHY=y
CONFIG_POWER_SUPPLY=y
CONFIG_QCOM_POWER_SUPPLY=y
CONFIG_QPNP_SMB5=y
CONFIG_QPNP_QG=y
CONFIG_QPNP_SMB5_XIAOMI_THERMAL=y
CONFIG_QCOM_SPMI_ADC5=y

# PM6150L GPIO controller for the staged display reset signal.
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_REGULATOR_QPNP_LCDB=y
CONFIG_BACKLIGHT_QCOM_SPMI_WLED=y

# Use the downstream SM6150 display stack; Surya display nodes stay disabled.
CONFIG_SM_DISPCC_6150=y
CONFIG_QTI_DISPLAY_SM6150=y

# GENI SPI transport for the staged touch bus.
CONFIG_QCOM_GENI_SE=y
CONFIG_SPI_MSM_GENI=y
CONFIG_I2C_MSM_GENI=y

# Built-in link dependencies of downstream display, ICC and k61 diagnostics.
CONFIG_QCOM_IOMMU_UTIL=y
CONFIG_QCOM_MEM_BUF=y
CONFIG_QCOM_MEM_BUF_DEV=y
CONFIG_INTERCONNECT_QCOM_DEBUG=y
CONFIG_MAILBOX=y
CONFIG_QCOM_AOSS_QMP=y
