/* Offline fixture only: exercise the same single-symbol scheme as Violet. */
/* SDMMagpie names 0x1700000 aggre2, not aggre1. */
#define SM6150_AGGRE1_NOC_UNIT_ADDRESS 16e0000
#define SM6150_AGGRE1_NOC_REG 0x16e0000 0x11080
#include "surya-sm6150-cmd-db-test.dts"

/ {
	/* Give the target a phandle without exporting every label with -@. */
	xiaomi,surya-overlay-target = <&soc>;
	__symbols__ {
		soc = "/soc";
	};
};

/* Avoid the inherited QoS MMIO programming during bring-up. Keep RPMh votes. */
&dc_noc { qcom,skip-qos; };
&gem_noc { qcom,skip-qos; };
&config_noc { qcom,skip-qos; };
&system_noc { qcom,skip-qos; };
&aggre1_noc {
	qcom,skip-qos;
	/* These bulk clocks serve QoS setup only; UFS keeps its own clocks. */
	/delete-property/ clocks;
};
&mmss_noc { qcom,skip-qos; };

/* The FSociety SDMMagpie base and Surya overlay use UFS without an IOMMU specifier. */
&ufshc_mem {
	/delete-property/ iommus;
	/delete-property/ qcom,iommu-dma;
};

/* FSociety leaves the controller reset on the host, not on the PHY. */
&ufsphy_mem {
	/delete-property/ resets;
};

/* Keep this persistent region out of the linear RAM mapping for earlycon. */
&{/reserved-memory/ramoops@9d800000} {
	no-map;
};

/* Select the SDMMagpie UFS clock offsets without changing the clock IDs. */
&gcc {
	compatible = "xiaomi,surya-gcc", "qcom,sm6150-gcc", "syscon";
};

/* RPMh clients obtain their controller from the immediate DRV parent. */
/delete-node/ &disp_bcm_voter;
&disp_rsc_drv0 {
	surya_disp_bcm_voter: bcm_voter {
		compatible = "qcom,bcm-voter";
		qcom,tcs-wait = <QCOM_ICC_TAG_AMC>;
	};
};

&mc_virt { qcom,bcm-voters = <&apps_bcm_voter>, <&surya_disp_bcm_voter>; };
&gem_noc { qcom,bcm-voters = <&apps_bcm_voter>, <&surya_disp_bcm_voter>; };
&mmss_noc { qcom,bcm-voters = <&apps_bcm_voter>, <&surya_disp_bcm_voter>; };
