/dts-v1/;

#include "sm6150.dtsi"
#include "surya-pinctrl.dtsi"
#include "surya-pm6150.dtsi"
#include "surya-display.dtsi"
#include "surya-touch.dtsi"
#include "surya-haptics.dtsi"
#include "surya-nfc.dtsi"

/* Bring-up stub only. Do not flash: inherited platform data is unvalidated. */
/ {
	model = "Xiaomi POCO X3 NFC";
	compatible = "xiaomi,surya", "qcom,sm6150";

	/* IDs from the 4.14 sdmmagpie-idp-overlay-miui.dts. */
	qcom,msm-id = <365 0x0>;
	qcom,board-id = <34 0>;
};

&reserved_memory {
	/*
	 * Preserve the 4.14 pstore layout: the real pstore console (not a
	 * hand-rolled earlycon header) is what the recovery's 4.14 ramoops
	 * reader exports reliably.  The November capture that produced the
	 * only complete boot log ran exactly with these sizes; every
	 * zero-owned variant captured nothing.
	 */
	ramoops@9d800000 {
		compatible = "ramoops";
		reg = <0x0 0x9d800000 0x0 0x00400000>;
		record-size = <0x80000>;
		pmsg-size = <0x200000>;
		console-size = <0x100000>;
		ecc-size = <0x10>;
		max-reason = <4>;
	};
};

/*
 * The shared SM6150 DT instantiates the 4.14-style vendor gdsc-regulator
 * devices under /soc, but that driver ioremaps the DT reg verbatim while
 * these nodes carry GCC-relative offsets (0x177004 etc.) — so every probe
 * pokes a dead window beside the GCC block.  The first complete boot log
 * (2026-11-27, build 5f716c31f) shows the resulting asynchronous SError
 * landing inside gdsc_probe at 0.33s: readl -> arm_serror_panic -> Kernel
 * panic.  The upstream boot path needs none of them: the 6.1 clock driver
 * owns GDSCs through its C tables, the UFS GDSC is left enabled by the
 * bootloaders exactly as on the stock 4.14 firmware, and the TBU vote
 * nodes have no 6.1 consumer.  Disable the whole family (Violet's own
 * device trees never instantiate it with this driver).
 */
&emac_gdsc { status = "disabled"; };
&pcie_0_gdsc { status = "disabled"; };
&ufs_phy_gdsc { status = "disabled"; };
&usb30_prim_gdsc { status = "disabled"; };
&usb20_sec_gdsc { status = "disabled"; };
&hlos1_vote_aggre_noc_mmu_audio_tbu_gdsc { status = "disabled"; };
&hlos1_vote_aggre_noc_mmu_tbu1_gdsc { status = "disabled"; };
&hlos1_vote_aggre_noc_mmu_tbu2_gdsc { status = "disabled"; };
&hlos1_vote_aggre_noc_mmu_pcie_tbu_gdsc { status = "disabled"; };
&hlos1_vote_mmnoc_mmu_tbu_hf0_gdsc { status = "disabled"; };
&hlos1_vote_mmnoc_mmu_tbu_hf1_gdsc { status = "disabled"; };
&hlos1_vote_mmnoc_mmu_tbu_sf_gdsc { status = "disabled"; };
&bps_gdsc { status = "disabled"; };
&ife_0_gdsc { status = "disabled"; };
&ife_1_gdsc { status = "disabled"; };
&ipe_0_gdsc { status = "disabled"; };
&titan_top_gdsc { status = "disabled"; };
&mdss_core_gdsc { status = "disabled"; };
&gpu_cx_gdsc { status = "disabled"; };
&gpu_gx_gdsc { status = "disabled"; };
&vcodec0_gdsc { status = "disabled"; };
&venus_gdsc { status = "disabled"; };

/*
 * CPU idle states.  This board ships a downstream (4.14-era) PSCI
 * implementation that refuses the OSI-mode switch -- "psci: failed to set PC
 * mode: -3" in every Surya capture -- and has no mapping for the state IDs the
 * inherited DT votes (0x40000003 "pc", 0x40000004 "rail-pc").  The 2026-11-27
 * 20:46 capture shows what that costs: CPU#7 stopped answering IPIs around the
 * first idle entry (~2s), so kick_all_cpus_sync() from the jump-label update
 * spun forever in smp_call_function_many_cond(), RCU never finished a grace
 * period, and init never ran.  Disabling the four CPU states leaves
 * cpuidle-psci with only the WFI state (drivers/cpuidle/dt_idle_states.c skips
 * unavailable states and cpuidle-psci.c adds WFI unconditionally), which is the
 * same idle the stock 4.14 kernel uses until its lpm-levels driver binds.
 * The cluster domain states stay described for the runtime-PM path but are
 * never entered, because no CPU state asks for a cluster power down.
 */
&SILVER_OFF { status = "disabled"; };
&SILVER_PLL_OFF { status = "disabled"; };
&GOLD_OFF { status = "disabled"; };
&GOLD_RAIL_OFF { status = "disabled"; };

/*
 * Boot arguments.  sm6150.dtsi ships fw_devlink.strict=1, which makes every
 * property that lists a phandle a mandatory probe dependency -- including the
 * ones whose supplier is a class device with no driver of its own (see the
 * UFS note below).  fw_devlink=permissive keeps the ordering hints but stops
 * deferring probes on suppliers that can never report "probed", which is how a
 * device tree whose suppliers are class devices (not bound platform drivers) is
 * booted.  The rest of the line is bring-up visibility: initcall_debug names
 * the last initcall that completed and every deferred-probe attempt boundary,
 * and both of those print at KERN_DEBUG, so the console loglevel has to be 8 --
 * loglevel=7 (the 2026-11-28 21:40 capture) hid the whole deferral story, and
 * it is also why the Surya storage snapshot lines were missing from it.
 */
&chosen {
	bootargs = "kpti=0 ssbd=force-off qcom_dma_heaps.enable_bitstream_contig_heap=y rcupdate.rcu_expedited=0 cpufreq.default_governor=performance fw_devlink=permissive cpuidle.off=1 initcall_debug=1 loglevel=8";
};

/*
 * GCC's CX voltage class.  This is the line that decides whether /soc/ufshc
 * ever probes, and capture 10 (2026-11-28 22:0x, console-ramoops-10.txt)
 * pins it exactly:
 *
 *   1.257457 Surya bringup: r0 probing /soc/clock-controller@100000
 *   1.257865 k61probe: 100000.clock-controller (gcc-sm6150)
 *   ... nothing, ever.  No "Registered GCC clocks", and no
 *   "Rate ... is greater than highest Fmax" line either, so the probe never
 *   reached qcom_cc_really_probe().
 *   5.347050 Surya bringup: provider chain still at /soc/clock-controller@100000
 *   21.475038 Surya bringup: deferred probe still in clock-controller@100000
 *   21.475181 task:kworker/u16:0 state:D ... __mutex_lock+0x408 __device_attach
 *
 * i.e. gcc_sm6150_probe() blocks with the device mutex held, and the serial
 * deferred pass queues behind it.  Before this capture the same probe never
 * even appeared to start, which is why the deferred-probe list looked empty.
 *
 * What it blocks on is the regulator graph, and the DT says why only GCC does:
 * gcc_sm6150_probe() (drivers/clk/qcom/gcc-sm6150.c:3488) makes three
 * mandatory devm_regulator_get() calls and returns the error of each, so an
 * unresolved rail is a probe that cannot finish.  In sm6150-regulator.dtsi the
 * three targets are not peers:
 *
 *   vdd_mx-supply    -> regulator-pm6150-s3           (leaf: no vin/parent edge)
 *   vdd_cx-supply    -> regulator-pm6150-s1          (parent-supply -> s3)
 *   vdd_cx_ao-supply -> regulator-pm6150-s1-level-ao (vin-supply -> s3-level-ao)
 *
 * The AO pair is the odd one out.  Its supplier is the MX AO arc child, whose
 * parent block rpmh-regulator-mxlvl carries no proxy-supply at all (only cxlvl
 * does, which is why the log reports the "Fixed dependency cycle(s)" notice for
 * cxlvl and the VRM LDOs but not for mxlvl), and no driver in this tree except
 * GCC asks for a vdd_cx_ao rail.  dispcc asks for vdd_cx only and its probe
 * returned in 6822 usecs in the same window -- that is the control case: same
 * regulator class, same ARC parent, one supply less, no stall.
 *
 * So the AO edge goes away for this board: vote the CX always-on class through
 * the same resolvable pm6150_s1_level regulator the non-AO class uses.  For a
 * level vote that is not a loss of information -- "AO" vs "NAPM" only selects
 * which RPMh TCS the write goes to, i.e. whether AOSD keeps the vote across
 * sleep, and CX is held up through the whole bring-up path (cpuidle.off=1, and
 * this firmware refuses OSI mode anyway: "psci: failed to set PC mode: -3").
 * The clock driver then keeps both classes pointing at one regulator; the core
 * takes the maximum request of the two, which is exactly the corner the
 * bootloader left the rail at.
 */
&gcc {
	vdd_cx_ao-supply = <&VDD_CX_LEVEL>;
};

/*
 * UFS host and PHY.  The 4.14 supply routing is deliberately NOT inherited.
 * Each *-supply here names an LDO child of a qcom,rpmh-vrm-regulator parent,
 * and the vendor rpmh-regulator driver registers those LDOs with
 * devm_regulator_register(): the regulator struct device carries the child
 * node as of_node but never becomes the primary fwnode device of that node,
 * so the fw_devlink link from the UFS nodes has no supplier device to wait
 * on and the consumer is parked without a single log line.  That is the exact
 * shape of the 2026-11-27 20:46 failure: "/soc/ufshc@1d84000 enabled;
 * unbound" and "/soc/ufsphy_mem@1d87000 enabled; unbound" at 4.58s with an
 * empty deferred-probe list, so no block device ever appeared for
 * first-stage init.
 *
 * Both drivers take an absent supply as "rail is already up": ufshcd does it
 * explicitly ("Unable to find %s regulator, assuming enabled"), ufs-qcom only
 * parses qcom,vddp-ref-clk when the property exists, and the QMP v3 PHY driver
 * never asks for vdda-phy/vdda-pll at all.  The rails must stay as the
 * bootloaders left them -- the boot device hangs off VCC/VCCQ2 -- so dropping
 * the phandles is both the unblock and the honest description of the boot
 * state.  Same reasoning as the removed vdd-hba-supply.
 */
&ufsphy_mem {
	compatible = "qcom,ufs-phy-qmp-v3";
	status = "disabled";
};

&ufshc_mem {
	/* Stock SDMMagpie uses the dedicated UFS_RESET pin, not GPIO 123. */
	/delete-property/ reset-gpios;
	/* Stock Surya UFS does not use the SM6150 boot fuse gate. */
	/delete-property/ nvmem-cells;
	/delete-property/ nvmem-cell-names;
	/delete-property/ boot_device_type;
	status = "disabled";
};

/* USB role detection requires the Surya PMIC and Type-C policy nodes. */
&usb0 {
	extcon = <&pm6150_pdphy>, <&pm6150_charger>;
	status = "disabled";
};

&usb1 {
	status = "disabled";
};
