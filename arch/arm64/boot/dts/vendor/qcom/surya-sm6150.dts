/dts-v1/;

#include "sm6150.dtsi"

/* Bring-up stub only. Do not flash: inherited platform data is unvalidated. */
/ {
	model = "Xiaomi POCO X3 NFC";
	compatible = "xiaomi,surya", "qcom,sm6150";

	/* IDs from the 4.14 sdmmagpie-idp-overlay-miui.dts. */
	qcom,msm-id = <365 0x0>;
	qcom,board-id = <34 0>;
};

&reserved_memory {
	/* Preserve the 4.14 pstore layout for boot diagnostics. */
	ramoops@9d800000 {
		compatible = "ramoops";
		reg = <0x0 0x9d800000 0x0 0x00400000>;
		record-size = <0x80000>;
		pmsg-size = <0x200000>;
		console-size = <0x100000>;
		ecc-size = <0x10>;
		max-reason = <4>;
	};
};
